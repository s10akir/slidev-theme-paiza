{
  "name": "slidev-theme-paiza",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@iconify-json/twemoji": "^1.2.5",
    "@slidev/types": "^52.19.1"
  },
  "devDependencies": {
    "@slidev/cli": "^52.19.1",
    "prettier": "^3.9.6",
    "prettier-plugin-slidev": "^1.0.5"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "M PLUS 2",
        "mono": "Fira Code"
      }
    }
  }
}
